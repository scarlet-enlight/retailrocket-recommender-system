// copy the entire file and rename it to appsettings.Development.json or appsettings.json
//
// replace the data/credentials of sections:
//
// - DefaultConnection: Host, Port, Database, Username, Password
// - Frontend: BaseUrl
// - Jwt: Key, Issuer, Audience, ExpiryMinutesDefault, ExpiryMinutesRememberMe
// - Smtp: Server, Port, SenderName, SenderEmail, Username, Password

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5559;Database=db;Username=user;Password=secret"
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "<protocol>://<name>:<port>"
  },
  "Jwt": {
    "Key": "secret-key",
    "Issuer": "<name>.API",
    "Audience": "<name>.Client",
    "ExpiryMinutesDefault": 60,
    "ExpiryMinutesRememberMe": 720
  },
  "Smtp": {
    "Server": "server-name@smtp.com",
    "Port": 587,
    "SenderName": "<name>",
    "SenderEmail": "<name>@<domain>.<region>",
    "Username": "<name_given_by_provider>@<provider>",
    "Password": "secret"
  }
}
